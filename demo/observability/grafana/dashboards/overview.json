{
 "uid": "rca-overview",
 "title": "RCA Demo Overview",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "p95 latency by service (s)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le, service) (rate(http_request_duration_seconds_bucket[1m])))",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Request rate by service",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "targets": [
    {
     "expr": "sum by (service) (rate(http_requests_total[1m]))",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "5xx rate by service",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "targets": [
    {
     "expr": "sum by (service) (rate(http_requests_total{status=~\"5..\"}[1m]))",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Memory (RSS) by service",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "targets": [
    {
     "expr": "process_resident_memory_bytes",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "DB connection hold time p95 (s)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le, service) (rate(db_query_duration_seconds_bucket[1m])))",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "DB pool connections checked out",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "targets": [
    {
     "expr": "db_pool_checked_out",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 7,
   "type": "logs",
   "title": "Errors and warnings",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "h": 10,
    "w": 24,
    "x": 0,
    "y": 24
   },
   "targets": [
    {
     "expr": "{service=~\".+\", level=~\"ERROR|WARNING\"}",
     "refId": "A"
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true
   }
  }
 ]
}